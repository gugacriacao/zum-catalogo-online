{
  "redirects": [
    {
      "source": "/",
      "destination": "/em-breve.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/teste",
      "destination": "/index.html"
    },
    {
      "source": "/teste/",
      "destination": "/index.html"
    },
    {
      "source": "/teste/vendaszap",
      "destination": "/vendaszap.html"
    },
    {
      "source": "/teste/vendaszap/",
      "destination": "/vendaszap.html"
    },
    {
      "source": "/cadastrovenda",
      "destination": "/cadastrovenda.html"
    },
    {
      "source": "/cadastrovenda/",
      "destination": "/cadastrovenda.html"
    }
  ],
  "headers": [
    {
      "source": "/produtos.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/banners.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/cadastrovenda(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}